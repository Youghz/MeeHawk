{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": ".claude/hooks/pre-commit-check.sh",
            "timeout": 300,
            "statusMessage": "Running flutter analyze + flutter test before commit"
          }
        ]
      }
    ]
  }
}
